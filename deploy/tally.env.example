# /etc/tally/tally.env  (root:root 600). Restart after editing: sudo systemctl restart tally

# PAPER = simulated fills. Switch to LIVE only after paper trading has behaved for a while.
TALLY_MODE=PAPER

# Header X-Tally-Token for every /api call. Generated by setup-server.sh.
TALLY_API_TOKEN=

# https://developers.kite.trade -> your app.
# Redirect URL: https://<your-domain>/auth/callback (after deploy/setup-https.sh) or http://127.0.0.1:8090/auth/callback
KITE_API_KEY=
KITE_API_SECRET=
# Your Zerodha client ID (e.g. AB1234). Logins from any other account are rejected.
KITE_USER_ID=

ANTHROPIC_API_KEY=
